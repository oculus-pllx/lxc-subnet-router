[Unit]
Description=LXC Subnet Router Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/lxc-subnet-router
Environment=LXC_SUBNET_ROUTER_CONFIG=/opt/lxc-subnet-router/config/router.yaml
ExecStart=/opt/lxc-subnet-router/venv/bin/uvicorn lxc_subnet_router.web:app --host 0.0.0.0 --port 8443
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
